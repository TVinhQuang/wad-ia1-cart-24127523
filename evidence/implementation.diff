index 011edf2..80efd26 100644
--- a/src/cart.js
+++ b/src/cart.js
@@ -1 +1 @@
-// Implement cartTotal here. See README.md for the specification.
+// Calculate the total in whole dong according to README.md.
@@ -3 +3,19 @@ export function cartTotal(items, options) {
-  throw new Error('not implemented')
+  if (items.length === 0) return 0
+
+  let subtotal = 0
+
+  for (const { price, qty } of items) {
+    if (price < 0) {
+      throw new RangeError('price must be non-negative')
+    }
+    if (!Number.isInteger(qty) || qty <= 0) {
+      throw new RangeError('qty must be a positive integer')
+    }
+
+    subtotal += price * qty
+  }
+
+  const vat = subtotal * options.vatRate
+  const shipping = subtotal >= options.freeShipFrom ? 0 : options.shipFee
+
+  return Math.round(subtotal + vat + shipping)
